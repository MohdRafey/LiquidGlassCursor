<Window x:Class="LiquidGlassCursor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liquid Glass Optical Studio"
        Height="640" Width="840"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F8FAFC"
        Closing="Window_Closing">

  <Window.Resources>
    <!-- Palette -->
    <SolidColorBrush x:Key="BgBase" Color="#090D16"/>
    <SolidColorBrush x:Key="BgCard" Color="#111827"/>
    <SolidColorBrush x:Key="BgControl" Color="#1A2333"/>
    <SolidColorBrush x:Key="BgControlHover" Color="#243044"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#1F2937"/>
    <SolidColorBrush x:Key="BorderHighlight" Color="#334155"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>

    <!-- Modern Toggle Switch -->
    <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#94A3B8" HorizontalAlignment="Left" Margin="2,0,0,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#0284C7"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="#38BDF8"/>
                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Dark Slider -->
    <Style x:Key="ModernSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="5" CornerRadius="2.5" Background="#1E293B" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" CornerRadius="2.5">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#0284C7" Offset="0"/>
                              <GradientStop Color="#38BDF8" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="16">
                          <Ellipse Fill="#38BDF8" Opacity="0.35"/>
                          <Ellipse Width="12" Height="12" Fill="#F8FAFC" Stroke="#38BDF8" StrokeThickness="2"/>
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Dark ComboBoxItem -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0C4A6E"/>
                <Setter Property="Foreground" Value="#38BDF8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Dark ComboBox -->
    <Style x:Key="ModernComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="{StaticResource BgControl}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderHighlight}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#94A3B8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{StaticResource BgControlHover}"/>
                        <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,0,32,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
              <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Margin="0,4,0,0">
                  <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="2">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <StackPanel IsItemsHost="True"/>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Primary & Secondary Pill Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="18,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#0284C7" Offset="0"/>
                  <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="18,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#283548"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Main Outer Window Container with Rounded Corners & Drop Shadow -->
  <Border Margin="12" CornerRadius="18" Background="{StaticResource BgBase}" BorderBrush="#1E293B" BorderThickness="1.2">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>

      <!-- Custom Draggable Title Bar -->
      <Border Grid.Row="0" Background="#0D1320" CornerRadius="18,18,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="22,0,16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Bold LG Monogram Logo -->
            <Border Background="#0C4A6E" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Text="LG" FontSize="13" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="LIQUID GLASS" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            <TextBlock Text="OPTICAL STUDIO" FontSize="14" FontWeight="Light" Foreground="#38BDF8" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Right Status Badge + Window Controls -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border x:Name="StatusBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="11,5" Margin="0,0,14,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#64748B" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusBadgeText" Text="STANDBY" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight"/>
              </StackPanel>
            </Border>

            <Button Content="—" Width="32" Height="32" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center" Click="MinimizeButton_Click"/>
            <Button Content="✕" Width="32" Height="32" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="13" Cursor="Hand" VerticalAlignment="Center" Click="CloseButton_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main Two-Column Control Dashboard -->
      <Grid Grid.Row="1" Margin="22,18,22,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Geometry, Contrast & Optical Sliders -->
        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="GEOMETRY &amp; SURFACE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

            <TextBlock Text="Pointer Silhouette" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox x:Name="ShapeSelector" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="Original Liquid Blob (Organic Metaball)" Tag="OriginalBlob"/>
              <ComboBoxItem Content="Classic Glass Pointer (Arrow + Tail)" Tag="ClassicPointer"/>
              <ComboBoxItem Content="Sleek Stealth Dart (Concave)" Tag="SleekDart"/>
              <ComboBoxItem Content="Liquid Teardrop" Tag="LiquidDroplet"/>
              <ComboBoxItem Content="Minimal Lens Orb (Center Hotspot)" Tag="MinimalOrb"/>
            </ComboBox>

            <TextBlock Text="Light-Screen Contrast Engine" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox x:Name="VisibilitySelector" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,12" SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="Adaptive Luminance Rim + Contact Shadow" Tag="AdaptivePlusShadow"/>
              <ComboBoxItem Content="Adaptive Luminance Rim (Auto White Contrast)" Tag="AdaptiveLuminanceRim"/>
              <ComboBoxItem Content="Soft Floating Contact Shadow" Tag="FloatingContactShadow"/>
              <ComboBoxItem Content="Double-Bevel Optical Edge (Dark + Bright)" Tag="DoubleBevelOpticalEdge"/>
              <ComboBoxItem Content="Beer-Lambert Smoked Glass Absorption" Tag="BeerLambertAbsorption"/>
            </ComboBox>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Base Diameter" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="SizeSelector" Style="{StaticResource ModernComboBox}" SelectedIndex="1" SelectionChanged="Settings_Changed">
                  <ComboBoxItem Content="32 px · Micro" Tag="32"/>
                  <ComboBoxItem Content="44 px · Compact" Tag="44"/>
                  <ComboBoxItem Content="56 px · Medium" Tag="56"/>
                  <ComboBoxItem Content="72 px · Large" Tag="72"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Glass Tint" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="TintSelector" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="Settings_Changed">
                  <ComboBoxItem Content="Crystal Clear" Tag="#DCEBFF"/>
                  <ComboBoxItem Content="Glacier Cyan" Tag="#7DD3FC"/>
                  <ComboBoxItem Content="Prism Rose" Tag="#F9A8D4"/>
                  <ComboBoxItem Content="Smoked Quartz" Tag="#64748B"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Border Height="1" Background="#1F2937" Margin="0,0,0,14"/>
            <TextBlock Text="OPTICAL DISPERSION" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

            <!-- Magnification -->
            <DockPanel Margin="0,0,0,2">
              <TextBlock Text="Convex Magnification" Foreground="#E2E8F0" FontSize="12.5"/>
              <TextBlock x:Name="ZoomLabel" Text="1.35x" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
            </DockPanel>
            <Slider x:Name="ZoomSlider" Style="{StaticResource ModernSlider}" Minimum="1.0" Maximum="2.0" Value="1.35" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="Settings_Changed"/>

            <!-- Total Internal Reflection -->
            <DockPanel Margin="0,0,0,2">
              <TextBlock Text="Rim Refraction &amp; TIR Wrap" Foreground="#E2E8F0" FontSize="12.5"/>
              <TextBlock x:Name="RefractionLabel" Text="45%" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
            </DockPanel>
            <Slider x:Name="RefractionSlider" Style="{StaticResource ModernSlider}" Minimum="0.0" Maximum="1.0" Value="0.45" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Settings_Changed"/>
          </StackPanel>
        </Border>

        <!-- RIGHT COLUMN: Diffusion, Chromatic Split & Shake-to-Enlarge -->
        <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="14" Padding="18" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="SPECTRAL &amp; FROST" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

            <!-- Chromatic Aberration -->
            <DockPanel Margin="0,0,0,2">
              <TextBlock Text="Chromatic Aberration (RGB Split)" Foreground="#E2E8F0" FontSize="12.5"/>
              <TextBlock x:Name="ChromaticLabel" Text="3.2 px" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
            </DockPanel>
            <Slider x:Name="ChromaticSlider" Style="{StaticResource ModernSlider}" Minimum="0.0" Maximum="7.0" Value="3.2" TickFrequency="0.2" IsSnapToTickEnabled="True" Margin="0,0,0,12" ValueChanged="Settings_Changed"/>

            <!-- Frosted Blur -->
            <DockPanel Margin="0,0,0,2">
              <TextBlock Text="Frosted Blur Diffusion" Foreground="#E2E8F0" FontSize="12.5"/>
              <TextBlock x:Name="BlurLabel" Text="1.2 px" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
            </DockPanel>
            <Slider x:Name="BlurSlider" Style="{StaticResource ModernSlider}" Minimum="0.0" Maximum="4.0" Value="1.2" TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,0,0,16" ValueChanged="Settings_Changed"/>

            <Border Height="1" Background="#1F2937" Margin="0,0,0,14"/>

            <!-- Shake to Enlarge Header + Toggle -->
            <DockPanel Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="SHAKE TO ENLARGE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="macOS-style rapid gesture locator" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
              </StackPanel>
              <CheckBox x:Name="ShakeCheckBox" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
            </DockPanel>

            <StackPanel x:Name="ShakeControlsPanel">
              <!-- Sensitivity -->
              <DockPanel Margin="0,0,0,2">
                <TextBlock Text="Trigger Sensitivity" Foreground="#E2E8F0" FontSize="12.5"/>
                <TextBlock x:Name="ShakeSensLabel" Text="1.0x (Normal)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
              </DockPanel>
              <Slider x:Name="ShakeSensSlider" Style="{StaticResource ModernSlider}" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="Settings_Changed"/>

              <!-- Multiplier -->
              <DockPanel Margin="0,0,0,2">
                <TextBlock Text="Enlarged Scale Multiplier" Foreground="#E2E8F0" FontSize="12.5"/>
                <TextBlock x:Name="ShakeScaleLabel" Text="2.0x" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
              </DockPanel>
              <Slider x:Name="ShakeScaleSlider" Style="{StaticResource ModernSlider}" Minimum="1.4" Maximum="3.0" Value="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="Settings_Changed"/>

              <!-- Hold Duration -->
              <DockPanel Margin="0,0,0,2">
                <TextBlock Text="Hold Duration" Foreground="#E2E8F0" FontSize="12.5"/>
                <TextBlock x:Name="ShakeTimeLabel" Text="1.2 s" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
              </DockPanel>
              <Slider x:Name="ShakeTimeSlider" Style="{StaticResource ModernSlider}" Minimum="0.4" Maximum="3.0" Value="1.2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Settings_Changed"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Bottom Action Footer -->
      <Border Grid.Row="2" Background="#0D1320" CornerRadius="0,0,18,18" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="22,0">
        <Grid>
          <TextBlock x:Name="StatusText"
                     Text="Ready. Click Activate to engage real-time optical lens."
                     Foreground="{StaticResource TextSecondary}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     MaxWidth="410"
                     TextTrimming="CharacterEllipsis"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Activate Liquid Glass" Height="38" Margin="0,0,10,0" Click="StartButton_Click"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Restore Default" Height="38" Click="StopButton_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>